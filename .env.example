# Database
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=article_cached
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/article_cached

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Application
NODE_ENV=development
PORT=3000

# TypeORM
MIGRATIONS_RUN=false

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Logging
LOG_LEVEL=info
